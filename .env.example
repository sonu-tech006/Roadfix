# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB connection URI (e.g., mongodb+srv://user:pass@cluster.mongodb.net/roadfix)
# If omitted or unavailable, RoadFix gracefully initializes high-fidelity persistent storage with full seed datasets.
MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/roadfix?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="roadfix-super-secure-production-jwt-token-secret-2026"

# CLOUDINARY CONFIGURATION (Optional for live Cloudinary storage; native local uploads work out of the box)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
